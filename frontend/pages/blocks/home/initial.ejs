<main class="page-tab" id="tab-initial">
  <div class="container-fluid py-3 dynatech-dashboard">

    <!-- Row 1: KPI strip -->
    <div class="row g-3 mb-3 dx-kpi-row">
      <!-- Total Cameras -->
      <div class="col-6 col-md-4 col-xl">
        <div class="card shadow-sm h-100 dx-card dx-kpi">
          <div class="card-body">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="dx-kpi-label">Total Cameras</div>
                <div class="dx-kpi-value" id="dx-kpi-total">0</div>
                <div class="dx-kpi-trend"><i class="fa fa-camera text-muted"></i> <span id="dx-kpi-total-sub" class="text-muted">cameras</span></div>
              </div>
              <span class="dx-kpi-icon dx-icon-blue"><i class="fa fa-video-camera"></i></span>
            </div>
          </div>
        </div>
      </div>
      <!-- Online Cameras (reuses active-count id) -->
      <div class="col-6 col-md-4 col-xl">
        <div class="card shadow-sm h-100 dx-card dx-kpi">
          <div class="card-body">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="dx-kpi-label">Online Cameras</div>
                <div class="dx-kpi-value text-success" id="dx-count-active">0</div>
                <div class="dx-kpi-trend"><span class="badge bg-success-subtle text-success" id="dx-pct-active">0%</span> <span class="text-muted">of total</span></div>
              </div>
              <span class="dx-kpi-icon dx-icon-green"><i class="fa fa-line-chart"></i></span>
            </div>
          </div>
        </div>
      </div>
      <!-- Offline / Error (combines inactive + error) -->
      <div class="col-6 col-md-4 col-xl">
        <div class="card shadow-sm h-100 dx-card dx-kpi">
          <div class="card-body">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="dx-kpi-label">Offline / Error</div>
                <div class="dx-kpi-value text-danger" id="dx-kpi-offline">0</div>
                <div class="dx-kpi-trend">
                  <span class="text-muted">Inactive <strong id="dx-count-inactive">0</strong></span>
                  &middot; <span class="text-muted">Error <strong id="dx-count-error">0</strong></span>
                  <span class="d-none" id="dx-pct-inactive"></span><span class="d-none" id="dx-pct-error"></span>
                </div>
              </div>
              <span class="dx-kpi-icon dx-icon-amber"><i class="fa fa-exclamation-triangle"></i></span>
            </div>
          </div>
        </div>
      </div>
      <!-- Recording: cameras actually writing to disk (mode 'record' vs watch-only).
           For a 24/7 recorder this is the number that matters most. -->
      <div class="col-6 col-md-4 col-xl">
        <div class="card shadow-sm h-100 dx-card dx-kpi">
          <div class="card-body">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="dx-kpi-label">Recording</div>
                <div class="dx-kpi-value text-success" id="dx-kpi-recording">0</div>
                <div class="dx-kpi-trend"><i class="fa fa-circle text-success" style="font-size:.5rem;vertical-align:middle"></i> <span class="text-muted" id="dx-kpi-recording-sub">cameras to disk</span></div>
              </div>
              <span class="dx-kpi-icon dx-icon-green"><i class="fa fa-hdd-o"></i></span>
            </div>
          </div>
        </div>
      </div>
      <% if(config.aiServicesEnabled){ %>
      <!-- Detections Today (AI-only: total + per-type breakdown from the events API) -->
      <div class="col-6 col-md-4 col-xl">
        <div class="card shadow-sm h-100 dx-card dx-kpi">
          <div class="card-body">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="dx-kpi-label">Detections Today</div>
                <div class="dx-kpi-value dx-icon-purple-text" id="dx-kpi-detections">0</div>
                <div class="dx-kpi-trend text-muted" id="dx-kpi-detections-sub"><span class="dx-placeholder-tag">awaiting feed</span></div>
              </div>
              <span class="dx-kpi-icon dx-icon-purple"><i class="fa fa-bolt"></i></span>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Row: NAS storage status -->
    <div class="row g-3 mb-3">
      <div class="col-12">
        <div class="card shadow-sm dx-card" id="dxNasCard" style="cursor:pointer" title="Open Storage &amp; Retention details">
          <div class="card-body">
            <div class="d-flex align-items-center flex-wrap gap-3">
              <div class="d-flex align-items-center gap-2" style="min-width:180px">
                <span id="dxNasDot" style="width:16px;height:16px;border-radius:50%;background:#888;flex:none;box-shadow:0 0 6px rgba(0,0,0,.25)"></span>
                <div>
                  <div class="dx-kpi-label"><i class="fa fa-hdd-o me-1"></i>NAS Storage</div>
                  <div class="fw-bold" id="dxNasLevel" style="font-size:1.1rem">—</div>
                </div>
              </div>
              <div class="flex-grow-1" style="min-width:220px">
                <div class="d-flex justify-content-between small mb-1">
                  <span id="dxNasMessage" class="text-muted">Checking NAS…</span>
                  <span id="dxNasBarPct" class="text-muted"></span>
                </div>
                <div class="progress" style="height:14px">
                  <div id="dxNasBar" class="progress-bar" style="width:0%;background:#16a34a"></div>
                </div>
                <div class="small text-muted mt-1">
                  <span id="dxNasFree" class="fw-bold text-body">—</span> free of
                  <span id="dxNasTotal" class="fw-bold text-body">—</span>
                </div>
              </div>
              <div style="min-width:160px">
                <div id="dxNasChips" class="mb-1"></div>
                <div class="small text-muted">
                  <div>Last recording: <span id="dxNasLastWrite" class="text-body">—</span></div>
                  <div><span id="dxNasRecording" class="text-body">—</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 2: Live View + Recent Alerts -->
    <div class="row g-3 mb-3">
      <!-- Live View (takes the full row when the AI-only Recent Alerts card is hidden) -->
      <div class="<%- config.aiServicesEnabled ? 'col-lg-8' : 'col-lg-12' %>">
        <div class="card shadow-sm h-100 dx-card">
          <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <h6 class="mb-0"><i class="fa fa-video-camera text-primary me-1"></i> Live View</h6>
              <div class="d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-outline-primary side-menu-link" page-open="liveGrid">
                  <i class="fa fa-th me-1"></i> Open full grid
                </a>
              </div>
            </div>
            <div class="row g-2" id="dx-live-grid">
              <!-- live tiles injected by JS; reuse .snapshot + data-mid so existing
                   monitor_snapshot websocket frames land here automatically -->
            </div>
            <div id="dx-live-empty" class="text-center text-muted py-5" style="display:none">
              <i class="fa fa-video-camera fa-2x mb-2 d-block text-muted"></i>
              No cameras to display
            </div>
          </div>
        </div>
      </div>
      <% if(config.aiServicesEnabled){ %>
      <!-- Recent Alerts (AI-only: fed by detection events; "View All" opens the
           Detections page, which is itself hidden when AI services are off) -->
      <div class="col-lg-4">
        <div class="card shadow-sm dx-card">
          <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <h6 class="mb-0"><i class="fa fa-bell text-warning me-1"></i> Recent Alerts</h6>
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-muted" id="dx-alerts-count">0</span>
                <a class="small side-menu-link dx-alerts-viewall" page-open="boxCount" style="cursor:pointer">View All</a>
              </div>
            </div>
            <div class="dx-alerts-list" id="dx-alerts-list">
              <!-- alert items injected by JS (any AI detection type) -->
            </div>
            <div id="dx-alerts-empty" class="text-center text-muted py-4" style="display:none">
              <i class="fa fa-check-circle fa-2x mb-2 d-block text-success-emphasis"></i>
              <div>No recent alerts</div>
              <small class="dx-placeholder-tag mt-2 mx-auto">awaiting feed</small>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Row 2: Server CPU / RAM / Disk gauges -->
    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <div class="card shadow-sm h-100 dx-card">
          <div class="card-body">
            <div class="row align-items-center text-center">
              <div class="col-4">
                <div class="fw-bold fs-5" id="dx-cpu-cores">0</div>
                <div class="small text-muted">CORES</div>
              </div>
              <div class="col-4">
                <div style="position:relative;width:90px;height:90px;margin:0 auto"><canvas id="dx-cpu-gauge"></canvas>
                  <div class="dx-gauge-label" id="dx-cpu-pct">0%</div>
                </div>
                <div class="small text-muted mt-1">CPU</div>
              </div>
              <div class="col-4">
                <div class="fw-bold fs-5" id="dx-cpu-os">-</div>
                <div class="small text-muted">PLATFORM</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card shadow-sm h-100 dx-card">
          <div class="card-body">
            <div class="row align-items-center text-center">
              <div class="col-4">
                <div class="fw-bold fs-5" id="dx-ram-used">0</div>
                <div class="small text-muted">USED (MB)</div>
              </div>
              <div class="col-4">
                <div style="position:relative;width:90px;height:90px;margin:0 auto"><canvas id="dx-ram-gauge"></canvas>
                  <div class="dx-gauge-label" id="dx-ram-pct">0%</div>
                </div>
                <div class="small text-muted mt-1">MEMORY</div>
              </div>
              <div class="col-4">
                <div class="fw-bold fs-5" id="dx-ram-total">0</div>
                <div class="small text-muted">TOTAL (MB)</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card shadow-sm h-100 dx-card">
          <div class="card-body">
            <div class="row align-items-center text-center">
              <div class="col-4">
                <div class="fw-bold fs-5" id="dx-disk-used">0</div>
                <div class="small text-muted">USED</div>
              </div>
              <div class="col-4">
                <div style="position:relative;width:90px;height:90px;margin:0 auto"><canvas id="dx-disk-gauge"></canvas>
                  <div class="dx-gauge-label" id="dx-disk-pct">0%</div>
                </div>
                <div class="small text-muted mt-1">STORAGE</div>
              </div>
              <div class="col-4">
                <div class="fw-bold fs-5" id="dx-disk-total">0</div>
                <div class="small text-muted">TOTAL</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 3: Analytics. The AI-event cards are hidden unless an AI service is attached;
         "Distribution by Region" is real camera data and always shown (full width when
         the AI cards are hidden). -->
    <div class="row g-3 mb-3">
      <% if(config.aiServicesEnabled){ %>
      <!-- Events over time -->
      <div class="col-lg-5">
        <div class="card shadow-sm h-100 dx-card">
          <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <h6 class="mb-0">AI Events Overview</h6>
              <span class="dx-placeholder-tag">awaiting feed</span>
            </div>
            <div class="d-flex gap-4 mb-2 align-items-center">
              <!-- Per-type totals rendered from the events actually present (top 3 by count). -->
              <div class="d-flex gap-4" id="dx-ai-type-totals"></div>
              <div class="ms-auto align-self-center"><span class="badge bg-light text-muted">Today</span></div>
            </div>
            <div style="position:relative;height:210px"><canvas id="dx-events-chart"></canvas></div>
          </div>
        </div>
      </div>
      <!-- Events by type -->
      <div class="col-lg-3">
        <div class="card shadow-sm h-100 dx-card">
          <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <h6 class="mb-0">Events by Type</h6>
              <span class="dx-placeholder-tag">awaiting feed</span>
            </div>
            <div style="position:relative;height:210px"><canvas id="dx-type-chart"></canvas></div>
          </div>
        </div>
      </div>
      <% } %>
      <!-- Distribution by region (REAL data) -->
      <div class="<%- config.aiServicesEnabled ? 'col-lg-4' : 'col-lg-12' %>">
        <div class="card shadow-sm h-100 dx-card">
          <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <h6 class="mb-0">Distribution by Region</h6>
              <small class="text-muted" id="dx-region-total">Total 0</small>
            </div>
            <div style="position:relative;height:210px"><canvas id="dx-region-chart"></canvas></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 4: Filterable camera list -->
    <div class="row g-3">
      <div class="col-12">
        <div class="card shadow-sm dx-card">
          <div class="card-body">
            <div class="d-flex flex-wrap align-items-center mb-3 gap-2">
              <strong class="me-2">Filters:</strong>
              <button type="button" class="btn btn-sm btn-success dx-filter" data-filter="active">Active</button>
              <button type="button" class="btn btn-sm btn-danger dx-filter" data-filter="inactive">Inactive</button>
              <button type="button" class="btn btn-sm btn-warning text-dark dx-filter" data-filter="error">Error</button>
              <button type="button" class="btn btn-sm btn-outline-secondary dx-filter active" data-filter="all">All</button>
              <div class="ms-auto" style="min-width:240px">
                <input type="text" id="dx-search" class="form-control form-control-sm" placeholder="Search camera by name or IP">
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-hover mb-0 align-middle" id="dx-camera-table">
                <thead class="table-light">
                  <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Mode</th>
                    <th>Host</th>
                    <th>Region</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody></tbody>
              </table>
            </div>
            <div id="dx-empty" class="text-center text-muted py-4" style="display:none">No cameras to show</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>
<style>
.dynatech-dashboard .dx-card { border:1px solid #e5e7eb; border-radius:10px; background:#fff !important; color:#1f2937 !important; }
.dynatech-dashboard .dx-card .card-body { color:#1f2937 !important; }
.dynatech-dashboard .dx-gauge-label { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-weight:600; font-size:0.95rem; color:#1f2937; }
.dynatech-dashboard .dx-filter.active { box-shadow: 0 0 0 2px rgba(13,110,253,0.35); }
.dynatech-dashboard #dx-camera-table thead th { font-size:0.85rem; text-transform:uppercase; letter-spacing:0.04em; }
.dynatech-dashboard .dx-status-dot { display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:6px; vertical-align:middle; }
.dynatech-dashboard .dx-status-active { background:#22c55e; }
.dynatech-dashboard .dx-status-inactive { background:#ef4444; }
.dynatech-dashboard .dx-status-error { background:#f59e0b; }

/* KPI strip */
.dynatech-dashboard .dx-kpi .card-body { padding:1rem 1.1rem; }
.dynatech-dashboard .dx-kpi-label { font-size:0.78rem; color:#6b7280; font-weight:600; letter-spacing:0.01em; }
.dynatech-dashboard .dx-kpi-value { font-size:1.9rem; font-weight:700; line-height:1.1; margin:0.15rem 0; }
.dynatech-dashboard .dx-kpi-trend { font-size:0.78rem; }
.dynatech-dashboard .dx-kpi-icon {
  width:46px; height:46px; border-radius:12px; flex:0 0 46px;
  display:flex; align-items:center; justify-content:center; font-size:1.15rem;
}
.dynatech-dashboard .dx-icon-blue   { background:#e0edff; color:#2563eb; }
.dynatech-dashboard .dx-icon-green  { background:#dcfce7; color:#16a34a; }
.dynatech-dashboard .dx-icon-amber  { background:#fef3c7; color:#d97706; }
.dynatech-dashboard .dx-icon-red    { background:#fee2e2; color:#dc2626; }
.dynatech-dashboard .dx-icon-purple { background:#ede9fe; color:#7c3aed; }
.dynatech-dashboard .bg-success-subtle { background:#dcfce7 !important; }
.dynatech-dashboard .dx-placeholder-tag {
  display:inline-block; font-size:0.68rem; padding:1px 7px; border-radius:10px;
  background:#f3f4f6; color:#9ca3af; border:1px dashed #d1d5db;
}
@media (min-width:1200px){ .dynatech-dashboard .dx-kpi-row > [class*="col-xl"] { flex:1 0 0; } }

/* Live View tiles */
.dynatech-dashboard .dx-live-tile {
  position:relative; border-radius:10px; overflow:hidden; background:#0f172a;
  aspect-ratio:16/10; cursor:pointer;
}
.dynatech-dashboard .dx-live-tile .snapshot {
  width:100%; height:100%; object-fit:cover; display:block;
}
.dynatech-dashboard .dx-live-tile .dx-live-label {
  position:absolute; left:8px; top:8px; z-index:2;
  background:rgba(15,23,42,0.78); color:#fff; font-size:0.72rem;
  padding:2px 8px; border-radius:6px; max-width:80%;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.dynatech-dashboard .dx-live-tile .dx-live-badge {
  position:absolute; right:8px; top:8px; z-index:2;
  display:inline-flex; align-items:center; gap:4px;
  background:rgba(15,23,42,0.78); color:#fff; font-size:0.66rem;
  padding:2px 7px; border-radius:6px;
}
.dynatech-dashboard .dx-live-tile .dx-live-dot {
  width:7px; height:7px; border-radius:50%; background:#9ca3af; display:inline-block;
}
.dynatech-dashboard .dx-live-tile.dx-live-on .dx-live-dot { background:#22c55e; box-shadow:0 0 0 3px rgba(34,197,94,0.25); }
.dynatech-dashboard .dx-live-tile .dx-live-noimg {
  width:100%; height:100%; display:flex; align-items:center; justify-content:center;
  color:#475569; font-size:1.6rem; background:#0f172a;
}

/* Detection popup (PNotify) — colored by severity, not by a hardcoded type */
.dx-ev-pnotify .ui-pnotify-title { font-weight:700 !important; }
.dx-ev-pnotify-high   { border-left:5px solid #dc2626 !important; }
.dx-ev-pnotify-high   .ui-pnotify-title { color:#dc2626 !important; }
.dx-ev-pnotify-medium { border-left:5px solid #d97706 !important; }
.dx-ev-pnotify-medium .ui-pnotify-title { color:#b45309 !important; }
.dx-ev-pnotify-low    { border-left:5px solid #2563eb !important; }
.dx-ev-pnotify-low    .ui-pnotify-title { color:#1d4ed8 !important; }

/* Recent Alerts list */
.dynatech-dashboard .dx-alerts-list { max-height:300px; overflow:auto; }
.dynatech-dashboard .dx-alerts-viewall { color:#2563eb; text-decoration:none; font-weight:600; }
.dynatech-dashboard .dx-alerts-viewall:hover { text-decoration:underline; }
.dynatech-dashboard .dx-alert-item {
  display:flex; gap:10px; align-items:center; padding:9px 6px;
  border-bottom:1px solid #f1f3f5;
}
.dynatech-dashboard .dx-alert-item:last-child { border-bottom:0; }
.dynatech-dashboard .dx-alert-thumb {
  width:46px; height:46px; flex:0 0 46px; border-radius:8px; object-fit:cover;
  background:#f3f4f6; display:flex; align-items:center; justify-content:center; color:#9ca3af;
}
.dynatech-dashboard .dx-alert-body { min-width:0; flex:1; }
.dynatech-dashboard .dx-alert-tag {
  display:inline-block; font-size:0.68rem; font-weight:600; padding:1px 8px; border-radius:10px;
}
/* Alert-tag colors now come from the shared event registry (inline styles), so any
   detection type renders without a per-type CSS rule. */
.dynatech-dashboard .dx-icon-purple-text { color:#7c3aed; }
.dynatech-dashboard .dx-alert-meta { font-size:0.74rem; color:#6b7280; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.dynatech-dashboard .dx-alert-time { font-size:0.72rem; color:#9ca3af; white-space:nowrap; }
.dynatech-dashboard .dx-sev-dot { width:8px; height:8px; border-radius:50%; display:inline-block; margin-right:4px; }
.dynatech-dashboard .dx-sev-high { background:#dc2626; }
.dynatech-dashboard .dx-sev-med  { background:#d97706; }
.dynatech-dashboard .dx-sev-low  { background:#2563eb; }
</style>
<script src="<%-window.libURL%>assets/js/bs5.dynatech-event-registry.js"></script>
<script src="<%-window.libURL%>assets/js/bs5.dynatech-dashboard.js"></script>
<script src="<%-window.libURL%>assets/js/bs5.nasIndicator.js"></script>
