<main class="container-fluid page-tab pt-3" id="tab-monitorBulkEdit">
  <div class="row">
    <!-- Left: choose what to change -->
    <div class="col-lg-5 mb-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="mb-1"><i class="fa fa-wrench me-1"></i> Bulk Monitor Settings</h5>
          <p class="text-muted small mb-3">
            Apply the same settings to many monitors at once. <b>Tick only the fields you want to change</b> —
            everything else on each monitor is left untouched. Uses the normal per-monitor save.
          </p>

          <!-- Recording -->
          <div class="mb-2 fw-bold small text-uppercase text-muted">Recording</div>
          <div class="mbe-field mb-2">
            <label class="form-check"><input type="checkbox" class="form-check-input mbe-apply" data-field="mode"> <span>Recording mode</span></label>
            <select class="form-select form-select-sm mt-1" data-field-value="mode">
              <option value="record">Record</option>
              <option value="start">Watch only (no recording)</option>
              <option value="stop">Disabled</option>
            </select>
          </div>
          <div class="mbe-field mb-3">
            <label class="form-check"><input type="checkbox" class="form-check-input mbe-apply" data-field="max_keep_days"> <span>Retention (days)</span></label>
            <input type="number" min="0" class="form-control form-control-sm mt-1" data-field-value="max_keep_days" placeholder="e.g. 30">
          </div>

          <!-- Streaming -->
          <div class="mb-2 fw-bold small text-uppercase text-muted">Streaming / live view</div>
          <div class="mbe-field mb-2">
            <label class="form-check"><input type="checkbox" class="form-check-input mbe-apply" data-field="stream_type"> <span>Stream type</span></label>
            <select class="form-select form-select-sm mt-1" data-field-value="stream_type">
              <option value="hls">HLS (needs H.264)</option>
              <option value="mp4">MP4 / fMP4</option>
              <option value="mjpeg">MJPEG</option>
              <option value="flv">FLV (websocket)</option>
            </select>
          </div>
          <div class="mbe-field mb-2">
            <label class="form-check"><input type="checkbox" class="form-check-input mbe-apply" data-field="substream_type"> <span>Sub-stream type</span></label>
            <select class="form-select form-select-sm mt-1" data-field-value="substream_type">
              <option value="hls">HLS</option>
              <option value="mp4">MP4 / fMP4</option>
              <option value="mjpeg">MJPEG</option>
              <option value="flv">FLV (websocket)</option>
            </select>
          </div>
          <div class="mbe-field mb-2">
            <label class="form-check"><input type="checkbox" class="form-check-input mbe-apply" data-field="stream_fps"> <span>Stream FPS</span></label>
            <input type="number" min="1" max="60" class="form-select form-select-sm mt-1" data-field-value="stream_fps" placeholder="e.g. 15">
          </div>
          <div class="mbe-field mb-2">
            <label class="form-check"><input type="checkbox" class="form-check-input mbe-apply" data-field="stream_vcodec"> <span>Live-view codec</span></label>
            <select class="form-select form-select-sm mt-1" data-field-value="stream_vcodec">
              <option value="copy">Copy (no CPU — needs H.264 source)</option>
              <option value="libx264">Transcode to H.264 (CPU heavy)</option>
            </select>
          </div>
          <div class="mbe-field mb-3">
            <label class="form-check"><input type="checkbox" class="form-check-input mbe-apply" data-field="path"> <span>Input stream path</span></label>
            <input type="text" class="form-control form-control-sm mt-1" data-field-value="path" placeholder="e.g. ch01_sub.264  (point monitors at the H.264 sub)">
            <div class="form-text">Rebuilds each monitor's RTSP URL with this path (same host/credentials). Use to point all monitors at the H.264 sub-stream.</div>
          </div>

          <!-- Credentials -->
          <div class="mb-2 fw-bold small text-uppercase text-muted">Credentials</div>
          <div class="mbe-field mb-2">
            <label class="form-check"><input type="checkbox" class="form-check-input mbe-apply" data-field="creds"> <span>Camera username / password</span></label>
            <div class="row g-2 mt-1">
              <div class="col-6"><input type="text" class="form-control form-control-sm" data-field-value="muser" placeholder="username"></div>
              <div class="col-6"><input type="password" class="form-control form-control-sm" data-field-value="mpass" placeholder="password"></div>
            </div>
            <div class="form-text">Updates credentials and rebuilds the RTSP URL for each selected monitor.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: choose which monitors + apply -->
    <div class="col-lg-7 mb-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="mb-0">Monitors <span class="badge bg-secondary" id="mbeSelectedCount">0 selected</span></h6>
            <div class="d-flex gap-2 align-items-center">
              <input type="search" class="form-control form-control-sm" id="mbeSearch" placeholder="Search" style="width:160px">
              <button class="btn btn-sm btn-outline-secondary" id="mbeSelectAll" type="button">Select all</button>
              <button class="btn btn-sm btn-outline-secondary" id="mbeSelectNone" type="button">None</button>
            </div>
          </div>
          <div id="mbeMonitorList" style="max-height:38vh; overflow:auto; border:1px solid #e5e7eb; border-radius:8px" class="p-2 mb-3">
            <div class="text-muted text-center py-4" id="mbeListEmpty">Loading monitors…</div>
          </div>

          <button type="button" class="btn btn-primary w-100" id="mbeApplyBtn">
            <i class="fa fa-bolt me-1"></i> Apply to selected monitors
          </button>
          <div class="form-text mt-1"><i class="fa fa-exclamation-triangle text-warning"></i> Test on <b>one</b> monitor first, confirm it behaves, then apply to the rest.</div>

          <div class="progress mt-3" style="height:18px; display:none" id="mbeProgressWrap">
            <div class="progress-bar progress-bar-striped progress-bar-animated" id="mbeProgressBar" style="width:0%">0%</div>
          </div>
          <div id="mbeResults" class="mt-2" style="max-height:30vh; overflow:auto"></div>
        </div>
      </div>
    </div>
  </div>
</main>
<script src="<%-window.libURL%>assets/js/bs5.monitorBulkEdit.js"></script>
