diff --git a/backend/libs/monitor/failureLog.js b/backend/libs/monitor/failureLog.js
new file mode 100644
index 0000000..4798959
--- /dev/null
+++ b/backend/libs/monitor/failureLog.js
@@ -0,0 +1,245 @@
+const fs = require('fs')
+const path = require('path')
+//
+// Per-camera stream failure log.
+//
+// LOG ONLY. Nothing in this file decides whether a stream starts, stops or
+// restarts, and nothing here is on the video path. It records what already
+// happened so that "camera X has no picture" can be answered without an SSH
+// session and a guess.
+//
+// Two files per camera, in <mainDirectory>/logs/streams/ (override with
+// "streamFailureLogDir" in conf.json):
+//
+//   <ke>_<mid>.log        append-only, human readable, survives restarts
+//   <ke>_<mid>.last.json  just the newest failure, so the dashboard can show a
+//                         reason for a camera that has been down since before
+//                         the last service restart
+//
+module.exports = function(s, config, lang){
+    // Enough to hold ffmpeg's input banner plus the actual error. The real
+    // cause is nearly always in the last few lines, but the banner above it is
+    // what tells you which codec and transport the camera agreed to.
+    const MAX_STDERR_LINES = 60
+    const MAX_LOG_BYTES = 2 * 1024 * 1024
+    const logDir = config.streamFailureLogDir || path.join(s.mainDirectory, 'logs', 'streams')
+
+    try{
+        fs.mkdirSync(logDir, { recursive: true })
+    }catch(err){
+        console.error(`Could not create stream failure log directory ${logDir}:`, err.message)
+    }
+
+    function redact(text, monitorConfig){
+        if(text === null || text === undefined)return ''
+        let safe = `${text}`
+        const details = (monitorConfig || {}).details || {}
+        const secrets = []
+        if(details.mpass){
+            secrets.push(details.mpass)
+            // The URL-encoded form leaks exactly as badly as the plain one.
+            try{
+                const encoded = encodeURIComponent(details.mpass)
+                if(encoded !== details.mpass)secrets.push(encoded)
+            }catch(err){}
+        }
+        // Longest first: a short password that is a substring of a longer one
+        // must not leave a fragment of the longer one behind.
+        secrets.sort((a, b) => b.length - a.length).forEach((secret) => {
+            safe = safe.split(secret).join('****')
+        })
+        // Belt and braces. Catches a password typed into the Host field, and
+        // the URLs ffmpeg likes to echo back inside its own error messages.
+        return safe.replace(/(:\/\/)([^/:@\s]+):([^/@\s]+)@/g, '$1$2:****@')
+    }
+
+    function logPath(groupKey, monitorId, suffix){
+        // Group key and monitor id are generated ids, but they end up in a file
+        // path, so refuse anything that is not one.
+        const safeName = `${groupKey}_${monitorId}`.replace(/[^a-zA-Z0-9_-]/g, '')
+        return path.join(logDir, safeName + suffix)
+    }
+
+    // ffmpeg announces the codec it negotiated in its input banner. When no
+    // probe has run, that line is the only place the camera's real codec shows
+    // up - and "no picture in the browser" is H.265 often enough to be worth
+    // catching for free.
+    function sniffCodec(line){
+        const match = line.match(/Stream #\d+:\d+.*?:\s*Video:\s*([a-zA-Z0-9_]+)/)
+        return match ? match[1].toLowerCase() : null
+    }
+
+    // singleCamera.js reports ffmpeg's own exit status on this line. The node
+    // wrapper's exit code is not ffmpeg's, so this is the only way to see it.
+    function sniffExit(line){
+        const match = line.match(/Process Closed: code=(-?\d+|null) signal=(\S+)/)
+        if(!match)return null
+        return {
+            code: match[1] === 'null' ? null : parseInt(match[1], 10),
+            signal: match[2] === 'null' ? null : match[2],
+        }
+    }
+
+    // Called for every chunk of stderr from the camera process. Keeps a bounded
+    // ring buffer in memory; writes nothing to disk until something fails.
+    function noteStderr(activeMonitor, monitorConfig, chunk){
+        if(!activeMonitor)return
+        try{
+            const text = redact(chunk.toString(), monitorConfig)
+            if(!activeMonitor.recentFfmpegStderr)activeMonitor.recentFfmpegStderr = []
+            const buffer = activeMonitor.recentFfmpegStderr
+            text.split('\n').forEach((rawLine) => {
+                const line = rawLine.trim()
+                if(!line)return
+                buffer.push(line)
+                const codec = sniffCodec(line)
+                if(codec)activeMonitor.detectedVideoCodec = codec
+                const exitInfo = sniffExit(line)
+                if(exitInfo){
+                    activeMonitor.lastFfmpegExitCode = exitInfo.code
+                    activeMonitor.lastFfmpegSignal = exitInfo.signal
+                }
+            })
+            if(buffer.length > MAX_STDERR_LINES){
+                buffer.splice(0, buffer.length - MAX_STDERR_LINES)
+            }
+        }catch(err){
+            // A logger must never be the thing that takes a camera down.
+        }
+    }
+
+    function rotateIfBig(filePath){
+        try{
+            if(fs.statSync(filePath).size > MAX_LOG_BYTES){
+                fs.renameSync(filePath, filePath + '.1')
+            }
+        }catch(err){
+            // No file yet, or it is already being rotated. Either way, append.
+        }
+    }
+
+    function formatBlock(record){
+        const lines = [
+            '',
+            '='.repeat(78),
+            `${record.time}  ${record.name} (${record.mid})  failure #${record.failureCount}`,
+            '='.repeat(78),
+            `reason         : ${record.reason}`,
+            `ffmpeg exit    : ${record.exitCode === null || record.exitCode === undefined ? 'unknown' : record.exitCode}` +
+                `${record.signal ? ` (signal ${record.signal})` : ''}`,
+            `rtsp transport : ${record.rtspTransport}`,
+            `codec reported : ${record.codec}`,
+            `monitor        : ${record.ke}/${record.mid}  mode=${record.mode}  type=${record.inputType}`,
+            `ffmpeg command : ${record.cmd}`,
+            'ffmpeg stderr  :',
+        ]
+        if(record.stderr.length === 0){
+            lines.push('    (nothing captured - the process died before ffmpeg wrote anything,')
+            lines.push('     which usually means the binary or the input URL is wrong)')
+        }else{
+            record.stderr.forEach((line) => lines.push('    ' + line))
+        }
+        return lines.join('\n') + '\n'
+    }
+
+    // The one funnel every stream failure passes through.
+    function recordFailure(monitorConfig, activeMonitor, reason){
+        try{
+            if(!monitorConfig)return null
+            const groupKey = monitorConfig.ke
+            const monitorId = monitorConfig.mid || monitorConfig.id
+            if(!groupKey || !monitorId)return null
+            const details = monitorConfig.details || {}
+            const stderr = (activeMonitor && activeMonitor.recentFfmpegStderr) || []
+
+            const record = {
+                time: s.formattedTime(new Date(), 'YYYY-MM-DD HH:mm:ss'),
+                ke: groupKey,
+                mid: monitorId,
+                name: monitorConfig.name || monitorId,
+                reason: redact(reason, monitorConfig) || 'unknown',
+                exitCode: activeMonitor ? activeMonitor.lastFfmpegExitCode : null,
+                signal: activeMonitor ? activeMonitor.lastFfmpegSignal : null,
+                // "no" is Shinobi's own value for "let ffmpeg decide", which in
+                // practice means UDP first with a TCP fallback.
+                rtspTransport: details.rtsp_transport && details.rtsp_transport !== 'no'
+                    ? details.rtsp_transport
+                    : 'not set (ffmpeg default)',
+                codec: (activeMonitor && activeMonitor.detectedVideoCodec) || details.vcodec || 'unknown',
+                mode: monitorConfig.mode,
+                inputType: monitorConfig.type,
+                // Already password-stripped by sanitizedFfmpegCommand when it was
+                // built; redact again in case the host field carried credentials.
+                cmd: redact((activeMonitor && activeMonitor.ffmpeg) || '(command not recorded)', monitorConfig),
+                stderr: stderr.slice(),
+                failureCount: (activeMonitor && activeMonitor.errorFatalCount) || 1,
+            }
+
+            const filePath = logPath(groupKey, monitorId, '.log')
+            rotateIfBig(filePath)
+            fs.appendFile(filePath, formatBlock(record), 'utf8', (err) => {
+                if(err)s.debugLog(`stream failure log write failed for ${monitorId}: ${err.message}`)
+            })
+
+            // Small enough for a synchronous write, and it has to be on disk
+            // before a crash for it to be worth anything.
+            const summary = {
+                time: record.time,
+                reason: record.reason,
+                exitCode: record.exitCode,
+                rtspTransport: record.rtspTransport,
+                codec: record.codec,
+                // The last few lines are where the cause is; the whole buffer
+                // belongs in the .log file, not in every dashboard payload.
+                lastStderr: record.stderr.slice(-4),
+                failureCount: record.failureCount,
+            }
+            try{
+                fs.writeFileSync(logPath(groupKey, monitorId, '.last.json'), JSON.stringify(summary), 'utf8')
+            }catch(err){
+                s.debugLog(`stream failure summary write failed for ${monitorId}: ${err.message}`)
+            }
+
+            if(activeMonitor)activeMonitor.lastStreamFailure = summary
+
+            s.tx(Object.assign({ f: 'monitor_stream_failure', ke: groupKey, mid: monitorId, id: monitorId }, summary), 'GRP_' + groupKey)
+            return summary
+        }catch(err){
+            // Same rule as noteStderr: never take a camera down over a log line.
+            try{ s.debugLog(err) }catch(err2){}
+            return null
+        }
+    }
+
+    // Read-through for the dashboard. Survives a restart because the answer
+    // lives in .last.json; the file is read once per process per camera.
+    function getLastFailure(activeMonitor, groupKey, monitorId){
+        if(!activeMonitor)return null
+        if(activeMonitor.lastStreamFailure !== undefined)return activeMonitor.lastStreamFailure
+        let summary = null
+        try{
+            summary = JSON.parse(fs.readFileSync(logPath(groupKey, monitorId, '.last.json'), 'utf8'))
+        }catch(err){
+            summary = null // no failure has ever been recorded for this camera
+        }
+        activeMonitor.lastStreamFailure = summary
+        return summary
+    }
+
+    // A stream that comes up clean should not keep showing yesterday's reason.
+    function clearFailure(activeMonitor){
+        if(!activeMonitor)return
+        activeMonitor.recentFfmpegStderr = []
+        activeMonitor.lastFfmpegExitCode = null
+        activeMonitor.lastFfmpegSignal = null
+    }
+
+    return {
+        noteStderr,
+        recordFailure,
+        getLastFailure,
+        clearFailure,
+        redact,
+        logDir,
+    }
+}
