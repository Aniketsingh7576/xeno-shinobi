diff --git a/test/streamFailureLog.check.js b/test/streamFailureLog.check.js
new file mode 100644
index 0000000..1982150
--- /dev/null
+++ b/test/streamFailureLog.check.js
@@ -0,0 +1,110 @@
+// Runnable check for libs/monitor/failureLog.js.
+//
+//   node test/streamFailureLog.check.js
+//
+// No framework, no fixtures. It fails loudly if the failure log stops
+// redacting passwords, stops reading ffmpeg's exit code, or stops surviving a
+// restart - the three things the whole feature exists for.
+const assert = require('assert')
+const fs = require('fs')
+const os = require('os')
+const path = require('path')
+
+const workDir = fs.mkdtempSync(path.join(os.tmpdir(), 'shinobi-faillog-'))
+const sent = []
+
+// Minimal stand-in for Shinobi's `s`.
+const s = {
+    mainDirectory: workDir,
+    formattedTime: (date, format) => '2026-09-04 01:00:00',
+    debugLog: () => {},
+    tx: (data, room) => sent.push({ data, room }),
+}
+const config = { streamFailureLogDir: path.join(workDir, 'streams') }
+
+function makeLog(){
+    return require(path.join(__dirname, '..', 'backend', 'libs', 'monitor', 'failureLog.js'))(s, config, {})
+}
+
+const monitorConfig = {
+    ke: 'GROUP1',
+    mid: 'CAM1',
+    name: 'Front Gate',
+    mode: 'record',
+    type: 'h264',
+    details: { muser: 'admin', mpass: 'Abc@1234', rtsp_transport: 'tcp' },
+}
+
+const failureLog = makeLog()
+const activeMonitor = {
+    ffmpeg: '-i rtsp://admin:Abc@1234@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0 -f flv ...',
+    errorFatalCount: 2,
+}
+
+// --- feed it what ffmpeg actually emits ----------------------------------
+failureLog.noteStderr(activeMonitor, monitorConfig, Buffer.from([
+    'Input #0, rtsp, from \'rtsp://admin:Abc@1234@192.168.1.108:554/cam/realmonitor\':',
+    '  Stream #0:0: Video: hevc (Main), yuvj420p(pc), 2592x1944, 15 fps',
+    '[rtsp @ 000001] method DESCRIBE failed: 401 Unauthorized (password was Abc@1234)',
+    'Process Closed: code=1 signal=null',
+].join('\n')))
+
+assert.strictEqual(activeMonitor.detectedVideoCodec, 'hevc', 'codec should be read from the ffmpeg banner')
+assert.strictEqual(activeMonitor.lastFfmpegExitCode, 1, "ffmpeg's own exit code should be read, not the wrapper's")
+assert.strictEqual(activeMonitor.lastFfmpegSignal, null)
+activeMonitor.recentFfmpegStderr.forEach((line) => {
+    assert.ok(line.indexOf('Abc@1234') === -1, 'password leaked into the stderr buffer: ' + line)
+})
+
+// --- record a failure -----------------------------------------------------
+const summary = failureLog.recordFailure(monitorConfig, activeMonitor, 'Process Unexpected Exit')
+assert.ok(summary, 'recordFailure should return a summary')
+assert.strictEqual(summary.exitCode, 1)
+assert.strictEqual(summary.codec, 'hevc')
+assert.strictEqual(summary.rtspTransport, 'tcp')
+
+// --- the log file ---------------------------------------------------------
+const logFile = path.join(config.streamFailureLogDir, 'GROUP1_CAM1.log')
+// appendFile is async; give it a tick before reading.
+setTimeout(() => {
+    const text = fs.readFileSync(logFile, 'utf8')
+    assert.ok(text.indexOf('Abc@1234') === -1, 'password leaked into the log file')
+    assert.ok(text.indexOf('****') > -1, 'password should be replaced with ****')
+    assert.ok(text.indexOf('Process Unexpected Exit') > -1, 'reason missing from the log')
+    assert.ok(text.indexOf('ffmpeg exit    : 1') > -1, 'exit code missing from the log')
+    assert.ok(text.indexOf('rtsp transport : tcp') > -1, 'transport missing from the log')
+    assert.ok(text.indexOf('codec reported : hevc') > -1, 'codec missing from the log')
+    assert.ok(text.indexOf('401 Unauthorized') > -1, 'ffmpeg stderr missing from the log')
+    assert.ok(text.indexOf('Front Gate') > -1, 'camera identifier missing from the log')
+    assert.ok(text.indexOf('2026-09-04 01:00:00') > -1, 'timestamp missing from the log')
+
+    // --- the dashboard got told --------------------------------------------
+    assert.strictEqual(sent.length, 1, 'a websocket event should be sent')
+    assert.strictEqual(sent[0].data.f, 'monitor_stream_failure')
+    assert.strictEqual(sent[0].room, 'GRP_GROUP1')
+    assert.ok(JSON.stringify(sent[0].data).indexOf('Abc@1234') === -1, 'password leaked over the websocket')
+
+    // --- survives a restart -------------------------------------------------
+    // Fresh module, fresh (empty) activeMonitor: exactly the state after the
+    // service restarts while a camera is still down.
+    delete require.cache[require.resolve(path.join(__dirname, '..', 'backend', 'libs', 'monitor', 'failureLog.js'))]
+    const afterRestart = makeLog()
+    const freshActiveMonitor = {}
+    const recovered = afterRestart.getLastFailure(freshActiveMonitor, 'GROUP1', 'CAM1')
+    assert.ok(recovered, 'last failure should still be readable after a restart')
+    assert.strictEqual(recovered.reason, 'Process Unexpected Exit')
+    assert.strictEqual(recovered.exitCode, 1)
+
+    // A camera that has never failed must not invent one.
+    assert.strictEqual(afterRestart.getLastFailure({}, 'GROUP1', 'NEVERFAILED'), null)
+
+    // --- redaction of a password that was typed into the Host field ---------
+    assert.strictEqual(
+        afterRestart.redact('rtsp://root:someOtherPass@10.0.0.9/x', monitorConfig),
+        'rtsp://root:****@10.0.0.9/x',
+        'credentials embedded in a URL should be stripped even when they are not mpass'
+    )
